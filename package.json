{
    "name": "technical-assessment",
    "version": "1.0.0",
    "description": "Technical Assessment - A trust-minimised implementation of a multiplayer online game",
    "type": "module",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "engineStrict": false,
    "scripts": {
        "postinstall": "cd server && npm install --include=dev && cd ../client && npm install && cd ..",
        "client": "cd client && npx vite",
        "server": "node start-server.js",
        "install-server": "cd server && npm install --include=dev"
    },
    "devDependencies": {
        "nodemon": "^3.1.0"
    },
    "dependencies": {
        "@geckos.io/phaser-on-nodejs": "^1.3.1",
        "@geckos.io/server": "^3.1.0",
        "phaser": "^4.2.1"
    }
}
